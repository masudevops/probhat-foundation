# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata, sitemap and share links)
NEXT_PUBLIC_SITE_URL=https://probhatfoundation.org

# Contact & pledge form email (Resend). Set these in Vercel for production.
# Without RESEND_API_KEY, dev logs submissions to the console; production returns "not configured".
RESEND_API_KEY=
# Inbox that receives form submissions (defaults to the email in content/site.json)
CONTACT_TO_EMAIL=info@probhatfoundation.org
# Sender on the Resend-verified domain
CONTACT_FROM_EMAIL="Probhat Foundation <noreply@probhatfoundation.org>"
